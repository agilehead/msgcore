{
  "name": "@agilehead/msgcore",
  "version": "0.0.1",
  "description": "Standalone conversation and messaging service",
  "type": "module",
  "private": true,
  "workspaces": [
    "services/*",
    "services/*/apps/*",
    "services/*/node/packages/*"
  ],
  "scripts": {
    "build": "npm run verify:structure && ./scripts/build.sh --no-format && ./node_modules/.bin/tsc -p services/msgcore/tests/http/tsconfig.json && node services/msgcore/csharp/scripts/generate-model.mjs --check && dotnet build MsgCore.CSharp.slnx --disable-build-servers -p:UseSharedCompilation=false",
    "clean": "./scripts/clean.sh",
    "start": "./services/msgcore/scripts/start.sh",
    "test": "node services/msgcore/scripts/test-services.mjs",
    "test:http": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 services/msgcore/tests/http/index.ts",
    "migrate:msgcore:latest": "knex migrate:latest --knexfile services/msgcore/knexfile.msgcore.mjs",
    "migrate:msgcore:rollback": "knex migrate:rollback --knexfile services/msgcore/knexfile.msgcore.mjs",
    "migrate:msgcore:status": "knex migrate:status --knexfile services/msgcore/knexfile.msgcore.mjs",
    "migrate:msgcore:make": "knex migrate:make --knexfile services/msgcore/knexfile.msgcore.mjs",
    "build:native": "node services/msgcore/csharp/scripts/publish-native.mjs",
    "test:integration": "./services/msgcore/scripts/test-integration.sh compose",
    "lint": "./scripts/lint-all.sh && ./node_modules/.bin/eslint \"services/msgcore/**/*.mjs\"",
    "verify:structure": "node scripts/verify-structure.mjs",
    "format": "./scripts/format-all.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/chai": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "chai": "^5.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsonwebtoken": "^9.0.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "knex": "^3.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agilehead/msgcore.git"
  },
  "keywords": [
    "messaging",
    "conversations",
    "graphql",
    "typescript"
  ],
  "author": "Agilehead",
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.27.2": true,
    "lru-cache": false
  }
}
